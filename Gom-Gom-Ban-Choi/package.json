{
  "name": "gom-gom-rotate",
  "private": true,
  "description": "Gom Gom Rotate — web prototype. Chỉ cần Node.js, không cài thêm thư viện. Xem docs/porting.md khi chuyển sang Cocos.",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "studio": "node server.mjs --lan",
    "test": "node --test game/*.test.mjs game/*/*.test.mjs game/*/*/*.test.mjs tools/*/*.test.mjs",
    "economy": "node tools/economy/economy-report.mjs",
    "firebase:template": "node tools/export/firebase-template.mjs",
    "firebase:deploy": "node tools/export/firebase-template.mjs && npx -y firebase-tools@13 deploy --only remoteconfig",
    "firebase:pull": "npx -y firebase-tools@13 remoteconfig:get -o firebase/remoteconfig.from-firebase.json",
    "editor": "node tools/levels/level-editor.mjs",
    "cat-layouts": "node tools/levels/generate-cat-layouts.mjs",
    "simulate": "node tools/levels/simulate-levels.mjs 400",
    "simulate:profiles": "node tools/levels/simulate-profiles.mjs 100",
    "baseline": "node tools/levels/simulate-levels.mjs 400 --baseline",
    "build:html": "node tools/export/build-single-html.mjs",
    "export:data": "node tools/export/export-data.mjs",
    "export:art": "node tools/export/export-art.mjs",
    "export:sounds": "node tools/export/export-sounds.mjs",
    "export:models": "node tools/export/export-models.mjs",
    "export": "node tools/export/export-data.mjs && node tools/export/export-art.mjs && node tools/export/export-sounds.mjs"
  },
  "engines": { "node": ">=20" }
}
